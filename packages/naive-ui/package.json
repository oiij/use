{
  "name": "@oiij/naive-ui",
  "type": "module",
  "version": "0.0.83",
  "description": "Some Composable Functions And Components for Vue 3",
  "author": "oiij",
  "license": "MIT",
  "homepage": "https://github.com/oiij/use",
  "repository": {
    "type": "git",
    "url": "git@github.com:oiij/use.git"
  },
  "bugs": "https://github.com/oiij/use/issues",
  "keywords": [
    "@oiij/use",
    "naive-ui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "vue-tsc --noEmit && tsdown",
    "bumpp": "bumpp --no-push",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@oiij/css-render": "workspace:*",
    "@oiij/use": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "async-validator": "^4.2.5",
    "colord": "^2.10.0",
    "es-toolkit": "^1.52.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.42",
    "vue-component-type-helpers": "^3.3.11",
    "vue-hooks-plus": "^2.4.3",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@oiij/css-render": "workspace:*",
    "@oiij/use": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "async-validator": "^4.2.5",
    "colord": "^2.10.0",
    "es-toolkit": "^1.52.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.42",
    "vue-component-type-helpers": "^3.3.11",
    "vue-hooks-plus": "^2.4.3",
    "vue-router": "^5.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
