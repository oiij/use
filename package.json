{
  "name": "@oiij/use-monorepo",
  "type": "module",
  "version": "0.0.1",
  "description": "A monorepo for Vue 3 composables, components and utilities",
  "author": "oiij",
  "license": "MIT",
  "homepage": "https://github.com/oiij/use",
  "repository": {
    "type": "git",
    "url": "git@github.com:oiij/use.git"
  },
  "bugs": "https://github.com/oiij/use/issues",
  "keywords": [
    "use",
    "vue-use",
    "vue3",
    "typescript",
    "vue hooks"
  ],
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "pkg:dev": "pnpm -r --parallel run dev",
    "pkg:build": "pnpm -F @oiij/use -F @oiij/css-render  build && pnpm -F !@oiij/use -F !@oiij/css-render  build",
    "publish:all": "pnpm -r run publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm build",
    "release": "bumpp && npm publish",
    "awe": "pnpx are-we-esm",
    "nmi": "pnpx node-modules-inspector",
    "start": "esno src/index.ts",
    "test": "vitest",
    "update:deps": "taze -w && pnpm i",
    "type:check": "vue-tsc --noEmit",
    "cz": "czg",
    "commit": "git pull && git add -A && pnpm cz && git push",
    "link": "pnpm link --global",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@oiij/ai-editor": "workspace:*",
    "@oiij/auto-router": "workspace:*",
    "@oiij/chrome-tabs": "workspace:*",
    "@oiij/css-render": "workspace:*",
    "@oiij/directives": "workspace:*",
    "@oiij/e-charts": "workspace:*",
    "@oiij/emoji-picker": "workspace:*",
    "@oiij/hucre": "workspace:*",
    "@oiij/js-pdf": "workspace:*",
    "@oiij/markdown-it": "workspace:*",
    "@oiij/math-curve-loaders": "workspace:*",
    "@oiij/naive-ui": "workspace:*",
    "@oiij/ogl": "workspace:*",
    "@oiij/shiki": "workspace:*",
    "@oiij/spline": "workspace:*",
    "@oiij/three-js": "workspace:*",
    "@oiij/tiptap": "workspace:*",
    "@oiij/use": "workspace:*",
    "@oiij/utils": "workspace:*",
    "@oiij/v-charts": "workspace:*",
    "@oiij/xlsx": "workspace:*",
    "colord": "^2.10.0",
    "naive-ui": "^2.45.3",
    "three": "^0.186.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@oiij/tsconfig": "^0.0.4",
    "@oiij/unocss-preset": "^0.0.1",
    "@tsdown/css": "^0.23.0",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "@vitest/ui": "^5.0.0",
    "bumpp": "^12.3.0",
    "commitlint": "^21.2.2",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "^2.0.1",
    "esno": "^4.8.0",
    "jsonfile": "^6.2.1",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.28",
    "rolldown-plugin-dts": "^0.28.5",
    "rolldown-plugin-unocss": "^0.1.0",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.1.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "unocss": "^66.10.0",
    "unplugin-vue": "^7.2.0",
    "vitepress": "^1.6.4",
    "vitepress-demo-plugin": "^1.8.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm type:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm lint:fix"
    ]
  }
}
